# AI DataSense Environment Variables Configuration

# Server & Security
PROJECT_NAME="AI DataSense"
PORT=8000
JWT_SECRET="super-secret-datasense-key-2026-production-grade"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (Default: SQLite local, or set PostgreSQL URI for production)
# Example PostgreSQL: postgresql://postgres:password@localhost:5432/datasense_db
DATABASE_URL="sqlite:///./datasense.db"

# AI Provider API Keys (Optional: works with built-in heuristic analyst out-of-the-box!)
AI_API_KEY=""
AI_PROVIDER="auto" # auto, gemini, openai, heuristic

# Storage limits
MAX_UPLOAD_SIZE_MB=50
FRONTEND_URL="http://localhost:5173"
